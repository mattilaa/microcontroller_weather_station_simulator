// Weather text, JSON and CSV share integer-only formatting.
mod util::text;
use util::text::*;
mod app::weather_station;
use app::weather_station::*;
mod app::weather_model;
use app::weather_model::*;
pub fn write_reading(out: ptr<u8>, reading: ptr<Reading>) -> void {
    unsafe {
        write_time(out, (*reading).time);
        write_text(out, " temp ");
        write_fixed(out, i64((*reading).temperature), 2);
        write_text(out, " C | hum ");
        write_fixed(out, i64((*reading).humidity), 2);
        write_text(out, " %RH | wind ");
        write_fixed(out, i64((*reading).wind_speed), 2);
        write_text(out, " m/s from ");
        write_direction(out, (*reading).wind_direction);
        write_text(out, " | rain ");
        write_fixed(out, i64((*reading).rain), 2);
        write_text(out, " mm | cloud ");
        write_int(out, i64((*reading).cloud_cover));
        write_text(out, " % | ");
        write_fixed(out, i64((*reading).pressure), 1);
        write_text(out, " hPa");
    }
}

pub fn write_json(out: ptr<u8>, reading: ptr<Reading>) -> void {
    unsafe {
        write_text(out, "{\"day\":");
        write_int(out, i64((*reading).day));
        write_text(out, ",\"time\":\"");
        write_time(out, (*reading).time);
        write_text(out, "\"");
        write_text(out, ",\"temperature\":");
        write_fixed(out, i64((*reading).temperature), 2);
        write_text(out, ",\"humidity\":");
        write_fixed(out, i64((*reading).humidity), 2);
        write_text(out, ",\"wind_speed\":");
        write_fixed(out, i64((*reading).wind_speed), 2);
        write_text(out, ",\"wind_gust\":");
        write_fixed(out, i64((*reading).wind_gust), 2);
        write_text(out, ",\"wind_direction\":");
        write_int(out, i64((*reading).wind_direction));
        write_text(out, ",\"wind_compass\":\"");
        write_text(out, compass_point((*reading).wind_direction));
        write_text(out, "\"");
        write_text(out, ",\"rain\":");
        write_fixed(out, i64((*reading).rain), 2);
        write_text(out, ",\"rain_today\":");
        write_fixed(out, i64((*reading).rain_today), 2);
        write_text(out, ",\"cloud_cover\":");
        write_int(out, i64((*reading).cloud_cover));
        write_text(out, ",\"pressure\":");
        write_fixed(out, i64((*reading).pressure), 1);
        write_text(out, ",\"tornado\":");
        write_int(out, i64((*reading).tornado));
        write_text(out, ",\"lcl\":");
        write_int(out, i64((*reading).clouds.lcl));
        write_text(out, ",\"cirrus\":");
        write_int(out, i64((*reading).clouds.cirrus));
        write_text(out, ",\"altostratus\":");
        write_int(out, i64((*reading).clouds.altostratus));
        write_text(out, ",\"cumulus\":");
        write_int(out, i64((*reading).clouds.cumulus));
        write_text(out, ",\"cumulus_top\":");
        write_int(out, i64((*reading).clouds.cumulus_top));
        write_text(out, ",\"cumulonimbus\":");
        write_int(out, i64((*reading).clouds.cumulonimbus));
        write_text(out, ",\"cirrus_base\":");
        write_int(out, i64((*reading).clouds.cirrus_base));
        write_text(out, ",\"cirrus_top\":");
        write_int(out, i64((*reading).clouds.cirrus_top));
        write_text(out, ",\"altostratus_base\":");
        write_int(out, i64((*reading).clouds.altostratus_base));
        write_text(out, ",\"altostratus_top\":");
        write_int(out, i64((*reading).clouds.altostratus_top));
        write_text(out, ",\"stratus\":");
        write_int(out, i64((*reading).clouds.stratus));
        write_text(out, ",\"stratocumulus\":");
        write_int(out, i64((*reading).clouds.stratocumulus));
        write_text(out, ",\"nimbostratus\":");
        write_int(out, i64((*reading).clouds.nimbostratus));
        write_text(out, ",\"altocumulus\":");
        write_int(out, i64((*reading).clouds.altocumulus));
        write_text(out, ",\"stratus_top\":");
        write_int(out, i64((*reading).clouds.stratus_top));
        write_text(out, ",\"stratocumulus_top\":");
        write_int(out, i64((*reading).clouds.stratocumulus_top));
        write_text(out, ",\"nimbostratus_top\":");
        write_int(out, i64((*reading).clouds.nimbostratus_top));
        write_text(out, ",\"altocumulus_base\":");
        write_int(out, i64((*reading).clouds.altocumulus_base));
        write_text(out, ",\"altocumulus_top\":");
        write_int(out, i64((*reading).clouds.altocumulus_top));
    }
}

pub fn write_csv_row(out: ptr<u8>, sequence: u32, reading: ptr<Reading>) -> void {
    unsafe {
        write_int(out, i64(sequence));
        write_text(out, ",");
        write_int(out, i64((*reading).day));
        write_text(out, ",");
        write_minute(out, (*reading).time / 60);
        write_text(out, ",");
        write_fixed(out, i64((*reading).temperature), 2);
        write_text(out, ",");
        write_fixed(out, i64((*reading).humidity), 2);
        write_text(out, ",");
        write_fixed(out, i64((*reading).wind_speed), 2);
        write_text(out, ",");
        write_int(out, i64((*reading).wind_direction));
        write_text(out, ",");
        write_fixed(out, i64((*reading).rain), 2);
        write_text(out, ",");
        write_int(out, i64((*reading).cloud_cover));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.lcl));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.cirrus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.altostratus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.cumulus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.cumulus_top));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.cumulonimbus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.cirrus_base));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.cirrus_top));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.altostratus_base));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.altostratus_top));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.stratus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.stratocumulus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.nimbostratus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.altocumulus));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.stratus_top));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.stratocumulus_top));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.nimbostratus_top));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.altocumulus_base));
        write_text(out, ",");
        write_int(out, i64((*reading).clouds.altocumulus_top));
        write_text(out, ",");
        write_fixed(out, i64((*reading).pressure), 1);
        write_text(out, ",");
        write_fixed(out, i64((*reading).wind_gust), 2);
        write_text(out, ",");
        write_int(out, i64((*reading).tornado));
        write_text(out, "\n");
    }
}

pub fn write_weather_report(out: ptr<u8>, station: ptr<Station>, reading: ptr<Reading>, mean: ptr<Reading>) -> void {
    unsafe {
        write_text(out, "--- weather, day ");
        write_int(out, i64((*reading).day));
        write_text(out, " ");
        write_time(out, (*reading).time);
        write_text(out, ", speed ");
        write_int(out, i64((*station)._speed));
        write_text(out, "x, ");
        write_text(out, (*(*station)._model._scenario).name);
        write_text(out, " ---\n");
        write_text(out, "temperature:    ");
        write_fixed(out, i64((*reading).temperature), 2);
        write_text(out, " C");
        write_text(out, " (10-min mean ");
        write_fixed(out, i64((*mean).temperature), 2);
        write_text(out, " C");
        write_text(out, ")\n");
        write_text(out, "humidity:       ");
        write_fixed(out, i64((*reading).humidity), 2);
        write_text(out, " %RH");
        write_text(out, " (10-min mean ");
        write_fixed(out, i64((*mean).humidity), 2);
        write_text(out, " %RH");
        write_text(out, ")\n");
        write_text(out, "wind speed:     ");
        write_fixed(out, i64((*reading).wind_speed), 2);
        write_text(out, " m/s");
        write_text(out, " (10-min mean ");
        write_fixed(out, i64((*mean).wind_speed), 2);
        write_text(out, " m/s");
        write_text(out, ", gusts ");
        write_fixed(out, i64((*mean).wind_gust), 2);
        write_text(out, " m/s");
        write_text(out, ")\n");
        if (*reading).tornado > 0 {
            write_text(out, "TORNADO:        a tornado is passing the station\n");
        }
        write_text(out, "wind direction: ");
        write_direction(out, (*reading).wind_direction);
        write_text(out, " (10-min mean ");
        write_direction(out, (*mean).wind_direction);
        write_text(out, ")\n");
        write_text(out, "rain:           ");
        write_fixed(out, i64((*mean).rain), 2);
        write_text(out, " mm");
        write_text(out, " in this interval (today ");
        write_fixed(out, i64((*reading).rain_today), 2);
        write_text(out, " mm");
        write_text(out, ")\n");
        write_text(out, "pressure:       ");
        write_fixed(out, i64((*reading).pressure), 1);
        write_text(out, " hPa");
        write_text(out, " (10-min mean ");
        write_fixed(out, i64((*mean).pressure), 1);
        write_text(out, " hPa");
        write_text(out, ")\n");
        write_text(out, "cloud cover:    ");
        write_int(out, i64((*reading).cloud_cover));
        write_text(out, " %");
        write_text(out, " (10-min mean ");
        write_int(out, i64((*mean).cloud_cover));
        write_text(out, " %");
        write_text(out, ")\n");
        write_text(out, "cloud layers:   cirrus ");
        write_int(out, i64((*reading).clouds.cirrus));
        write_text(out, " %");
        write_text(out, " (");
        write_int(out, i64((*reading).clouds.cirrus_base));
        write_text(out, " hPa");
        write_text(out, "..");
        write_int(out, i64((*reading).clouds.cirrus_top));
        write_text(out, " hPa");
        write_text(out, ")");
        write_text(out, ", altostratus ");
        write_int(out, i64((*reading).clouds.altostratus));
        write_text(out, " %");
        write_text(out, " (");
        write_int(out, i64((*reading).clouds.altostratus_base));
        write_text(out, " hPa");
        write_text(out, "..");
        write_int(out, i64((*reading).clouds.altostratus_top));
        write_text(out, " hPa");
        write_text(out, ")");
        write_text(out, "\n                cumulus ");
        write_int(out, i64((*reading).clouds.cumulus));
        write_text(out, " %");
        write_text(out, " (top ");
        write_int(out, i64((*reading).clouds.cumulus_top));
        write_text(out, " hPa");
        write_text(out, "), cumulonimbus ");
        write_int(out, i64((*reading).clouds.cumulonimbus));
        write_text(out, " %");
        write_text(out, "\n");
        write_text(out, "                stratus ");
        write_int(out, i64((*reading).clouds.stratus));
        write_text(out, " %");
        write_text(out, " (top ");
        write_int(out, i64((*reading).clouds.stratus_top));
        write_text(out, " hPa");
        write_text(out, ")");
        write_text(out, ", stratocumulus ");
        write_int(out, i64((*reading).clouds.stratocumulus));
        write_text(out, " %");
        write_text(out, " (top ");
        write_int(out, i64((*reading).clouds.stratocumulus_top));
        write_text(out, " hPa");
        write_text(out, ")");
        write_text(out, "\n                nimbostratus ");
        write_int(out, i64((*reading).clouds.nimbostratus));
        write_text(out, " %");
        write_text(out, " (top ");
        write_int(out, i64((*reading).clouds.nimbostratus_top));
        write_text(out, " hPa");
        write_text(out, "), altocumulus ");
        write_int(out, i64((*reading).clouds.altocumulus));
        write_text(out, " %");
        write_text(out, " (");
        write_int(out, i64((*reading).clouds.altocumulus_base));
        write_text(out, " hPa");
        write_text(out, "..");
        write_int(out, i64((*reading).clouds.altocumulus_top));
        write_text(out, " hPa");
        write_text(out, ")\ncloud base:     LCL ");
        write_int(out, i64((*reading).clouds.lcl));
        write_text(out, " hPa");
        write_text(out, "\n");
    }
}
