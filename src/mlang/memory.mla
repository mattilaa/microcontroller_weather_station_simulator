// Volatile byte accesses prevent LLVM's loop-idiom passes from replacing these
// loops with recursive calls to memcpy/memset, and preserve strict alignment.
pub fn memory_copy(dst: ptr<u8>, src: ptr<u8>, size: u64) -> ptr<u8> {
    unsafe {
        var i: u64 = 0;
        while i < size { volatile_store(dst + i, volatile_load(src + i)); i += 1; }
        return dst;
    }
}
pub fn memory_move(dst: ptr<u8>, src: ptr<u8>, size: u64) -> ptr<u8> {
    unsafe {
        if ptr_address(dst) < ptr_address(src) { return memory_copy(dst, src, size); }
        var i: u64 = size;
        while i > 0 { i -= 1; volatile_store(dst + i, volatile_load(src + i)); }
        return dst;
    }
}
pub fn memory_fill(dst: ptr<u8>, value: i32, size: u64) -> ptr<u8> {
    unsafe {
        var i: u64 = 0;
        while i < size { volatile_store(dst + i, u8(value)); i += 1; }
        return dst;
    }
}
pub fn memory_compare(left: ptr<u8>, right: ptr<u8>, size: u64) -> i32 {
    unsafe {
        var i: u64 = 0;
        while i < size {
            let a: i32 = i32(volatile_load(left + i));
            let b: i32 = i32(volatile_load(right + i));
            if a != b { return a - b; }
            i += 1;
        }
        return 0;
    }
}
